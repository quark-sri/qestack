{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v qestack >/dev/null 2>&1; then qestack hook; fi",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
